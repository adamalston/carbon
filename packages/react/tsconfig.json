{
  "extends": "typescript-config-carbon/tsconfig.base.json",
  "compilerOptions": {
    // TODO: Switch Babel and TypeScript to the automatic JSX runtime when React
    // 16 support is dropped.
    // https://github.com/carbon-design-system/carbon/discussions/22396
    "jsx": "react",
    // TODO: Turn back on once stricter typings for internal utitlies are complete
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "icons/src/index.ts",
    "test-utils/**/*",
    "../../config/jest-config-carbon/setup/setupAfterEnv.ts"
  ],
  "exclude": ["**/*.figma.tsx", "src/examples/**/example/**"]
}
